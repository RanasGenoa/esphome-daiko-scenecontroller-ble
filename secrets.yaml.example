# ESPHome secrets.yaml 設定テンプレート
# このファイルを secrets.yaml にコピーして実際の環境値を設定してください。

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
wifi_hotspot_password: "YOUR_HOTSPOT_PASSWORD"

# Home Assistant Native API および OTA 暗号化キー (Noise プロトコル)
# `openssl rand -base64 32` で生成した 32バイト Base64 文字列を指定してください
api_encryption_key: "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

# OTA 更新パスワード
ota_password: "YOUR_OTA_PASSWORD"

# DAIKO BLE Mesh Keys
# `openssl rand -hex 16` 等で生成した任意の 32文字 (16バイト) の HEX 文字列を指定してください。
# ペアリング時に ESP32 がこの鍵を壁面コントローラーへ注入・配布します (PAIRING_GUIDE.md 参照)。
daiko_net_key: "0123456789ABCDEF0123456789ABCDEF"
daiko_app_key: "FEDCBA9876543210FEDCBA9876543210"
